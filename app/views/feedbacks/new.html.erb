<div style="max-width: 1000px; margin: 30px auto 60px; padding: 0 20px;">
  <% if flash[:notice] %>
    <div class="cart-notice"><%= flash[:notice] %></div>
  <% end %>

  <div style="display: flex; gap: 40px; flex-wrap: wrap; align-items: flex-start;">
    <div style="flex: 1; min-width: 280px; background: #f9fafb; border: 1px solid #e5e7eb; border-radius: 10px; padding: 24px;">
      <h2 style="margin-top: 0; font-size: 22px; color: #111827;">Контакти магазину</h2>
      <p style="color: #4b5563; font-size: 14px; line-height: 1.6; margin-bottom: 20px;">
        Маєте запитання щодо асортименту, розмірів чи доставки килимів? Зв'яжіться з нами зручним способом або заповніть форму праворуч.
      </p>

      <div style="display: flex; flex-direction: column; gap: 14px; font-size: 15px; color: #1f2937;">
        <div>
          <strong style="display: block; font-size: 13px; color: #6b7280; text-transform: uppercase;">Адреса шоуруму</strong>
          вул. Незалежності, 123, Київ, Україна
        </div>
        <div>
          <strong style="display: block; font-size: 13px; color: #6b7280; text-transform: uppercase;">Телефон</strong>
          +380 77 123 45 67
        </div>
        <div>
          <strong style="display: block; font-size: 13px; color: #6b7280; text-transform: uppercase;">Електронна пошта</strong>
          info@carpetstore.ua
        </div>
      </div>
    </div>

    <div style="flex: 1.3; min-width: 320px; background: #fff; border: 1px solid #e5e7eb; border-radius: 10px; padding: 24px;">
      <h2 style="margin-top: 0; font-size: 22px; color: #111827;">Зворотний зв'язок</h2>

      <%= form_with model: @feedback, local: true do |form| %>
        <% if @feedback.errors.any? %>
          <div class="auth-error">
            <ul style="margin: 0; padding-left: 18px;">
              <% @feedback.errors.full_messages.each do |msg| %>
                <li><%= msg %></li>
              <% end %>
            </ul>
          </div>
        <% end %>

        <div style="display: flex; gap: 14px;">
          <div class="auth-field" style="flex: 1;">
            <%= form.label :last_name, "Прізвище" %>
            <%= form.text_field :last_name, required: true, placeholder: "Сенишко" %>
          </div>

          <div class="auth-field" style="flex: 1;">
            <%= form.label :first_name, "Ім'я" %>
            <%= form.text_field :first_name, required: true, placeholder: "Андрій" %>
          </div>
        </div>

        <div class="auth-field">
          <%= form.label :phone, "Номер телефону" %>
          <%= form.text_field :phone, required: true, placeholder: "+380 88 123 45 67" %>
        </div>

        <div class="auth-field" style="margin-bottom: 20px;">
          <%= form.label :message, "Повідомлення" %>
          <%= form.text_area :message, rows: 4, required: true, placeholder: "Опишіть ваше запитання або побажання...", style: "width: 100%; padding: 10px; border: 1px solid #ccc; border-radius: 4px; box-sizing: border-box; font-family: inherit;" %>
        </div>

        <%= form.submit "Надіслати", class: "btn-primary" %>
      <% end %>
    </div>
  </div>

  <% if authenticated? && @my_feedbacks.any? %>
    <div style="margin-top: 40px; border-top: 1px solid #e5e7eb; padding-top: 28px;">
      <h3 style="margin-top: 0; font-size: 20px; color: #111827;">Мої попередні звернення</h3>

      <div style="display: flex; flex-direction: column; gap: 14px;">
        <% @my_feedbacks.each do |fb| %>
          <div style="background: #fff; border: 1px solid #e5e7eb; border-radius: 8px; padding: 16px 20px;">
            <div style="display: flex; justify-content: space-between; font-size: 13px; color: #6b7280; margin-bottom: 8px;">
              <span>Звернення #<%= fb.id %> від <%= fb.created_at.strftime("%d.%m.%Y %H:%M") %></span>
              <% if fb.admin_reply.present? %>
                <span style="background: #dcfce7; color: #166534; padding: 2px 10px; border-radius: 999px; font-weight: 600;">Є відповідь</span>
              <% else %>
                <span style="background: #fef3c7; color: #92400e; padding: 2px 10px; border-radius: 999px; font-weight: 600;">Очікує відповіді</span>
              <% end %>
            </div>

            <p style="margin: 0; color: #111827; font-size: 15px; white-space: pre-line;"><%= fb.message %></p>

            <% if fb.admin_reply.present? %>
              <div style="margin-top: 12px; background: #eff6ff; border-left: 3px solid #2563eb; padding: 10px 14px; border-radius: 4px;">
                <div style="font-size: 12px; font-weight: 600; color: #1d4ed8; margin-bottom: 4px;">
                  Відповідь адміністратора (<%= fb.replied_at&.strftime("%d.%m.%Y %H:%M") %>):
                </div>
                <div style="color: #1f2937; font-size: 14px; white-space: pre-line;"><%= fb.admin_reply %></div>
              </div>
            <% end %>
          </div>
        <% end %>
      </div>
    </div>
  <% end %>
</div>