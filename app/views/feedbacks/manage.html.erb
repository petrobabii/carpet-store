<div class="cart-container" style="max-width: 1100px;">
  <h2 class="cart-title">Звернення клієнтів</h2>

  <% if flash[:notice] %>
    <div class="cart-notice"><%= flash[:notice] %></div>
  <% end %>

  <% if @feedbacks.empty? %>
    <p style="color: #6b7280;">Звернень поки немає.</p>
  <% else %>
    <div style="display: flex; flex-direction: column; gap: 18px;">
      <% @feedbacks.each do |fb| %>
        <div style="background: #fff; border: 1px solid #e5e7eb; border-radius: 8px; padding: 20px;">
          <div style="display: flex; justify-content: space-between; align-items: flex-start; gap: 12px; border-bottom: 1px solid #f3f4f6; padding-bottom: 12px; margin-bottom: 12px;">
            <div>
              <strong style="font-size: 16px; color: #111827;"><%= fb.last_name %> <%= fb.first_name %></strong>
              <span style="margin-left: 10px; color: #374151; font-size: 14px;">Тел: <strong><%= fb.phone %></strong></span>
              <% if fb.user.present? %>
                <span style="margin-left: 10px; color: #6b7280; font-size: 13px;">(<%= fb.user.email_address %>)</span>
              <% end %>
              <div style="font-size: 12px; color: #9ca3af; margin-top: 2px;">
                Звернення #<%= fb.id %> від <%= fb.created_at.strftime("%d.%m.%Y %H:%M") %>
              </div>
            </div>

            <div style="display: flex; align-items: center; gap: 10px;">
              <% if fb.admin_reply.present? %>
                <span style="background: #dcfce7; color: #166534; padding: 4px 10px; border-radius: 999px; font-size: 12px; font-weight: 600;">Відповідь надано</span>
              <% else %>
                <span style="background: #fef3c7; color: #92400e; padding: 4px 10px; border-radius: 999px; font-size: 12px; font-weight: 600;">Нове звернення</span>
              <% end %>
              <%= button_to "Видалити", feedback_path(fb), method: :delete, data: { turbo_confirm: "Видалити це звернення?" }, class: "btn-cart-remove", style: "font-size: 12px; padding: 4px 10px;" %>
            </div>
          </div>

          <div style="margin-bottom: 16px; color: #1f2937; font-size: 15px; line-height: 1.5; white-space: pre-line;">
            <%= fb.message %>
          </div>

          <%= form_with model: fb, url: feedback_path(fb), method: :patch, local: true, style: "background: #f9fafb; padding: 14px; border-radius: 6px; border: 1px solid #e5e7eb;" do |f| %>
            <label style="display: block; font-size: 13px; font-weight: 600; color: #374151; margin-bottom: 6px;">
              Відповідь адміністратора:
            </label>
            <div style="display: flex; gap: 10px; align-items: flex-start;">
              <%= f.text_area :admin_reply, rows: 2, required: true, placeholder: "Напишіть відповідь клієнту...", style: "flex: 1; padding: 8px 10px; border: 1px solid #ccc; border-radius: 4px; font-family: inherit; font-size: 14px;" %>
              <%= f.submit (fb.admin_reply.present? ? "Оновити відповідь" : "Відповісти"), class: "btn-primary", style: "width: auto; padding: 10px 18px; font-size: 14px;" %>
            </div>
          <% end %>
        </div>
      <% end %>
    </div>
  <% end %>
</div>