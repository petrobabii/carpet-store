<div class="auth-container">
  <h2 class="auth-title">Вхід до магазину</h2>

  <% if flash[:alert] %>
    <div class="auth-error"><%= flash[:alert] %></div>
  <% end %>

  <% if flash[:notice] %>
    <div style="background: #d4edda; color: #155724; padding: 10px; border-radius: 4px; margin-bottom: 15px; font-size: 14px;">
      <%= flash[:notice] %>
    </div>
  <% end %>

  <%= form_with url: session_path, local: true do |form| %>
    <div class="auth-field">
      <%= form.label :email_address, "Email адреса" %>
      <%= form.email_field :email_address, required: true, autofocus: true, autocomplete: "email", placeholder: "example@gmail.com" %>
    </div>

    <div class="auth-field" style="margin-bottom: 20px;">
      <%= form.label :password, "Пароль" %>
      <%= form.password_field :password, required: true, autocomplete: "current-password", placeholder: "••••••••" %>
    </div>

    <div>
      <%= form.submit "Увійти", class: "btn-primary" %>
    </div>
  <% end %>

  <div class="auth-footer">
    Ще не маєте акаунта? 
    <%= link_to "Зареєструватися", new_user_path %>
  </div>
</div>