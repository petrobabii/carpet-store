<!DOCTYPE html>
<html>
  <head>
    <title>Carpet Store</title>
    <meta name="viewport" content="width=device-width,initial-scale=1">
    <%= csrf_meta_tags %>
    <%= csp_meta_tag %>

    <%= stylesheet_link_tag "application", "data-turbo-track": "reload" %>
    <%= javascript_importmap_tags %>
  </head>

  <body>
    <header>
      <div>
        <%= link_to "CARPET STORE", root_path, style: "font-weight: bold; text-decoration: none; font-size: 1.2rem; color: #111; letter-spacing: 1px;" %>
      </div>

      <div style="display: flex; align-items: center; gap: 20px;">
        <% if authenticated? %>
          <% if Current.user&.admin? %>
            <%= link_to "Управління товарами", manage_carpets_path, style: "text-decoration: none; color: #445; font-weight: 500;" %>
            <%= link_to "Усі замовлення", manage_orders_path, style: "text-decoration: none; color: #445; font-weight: 500;" %>
            <%= link_to "Звернення", manage_feedbacks_path, style: "text-decoration: none; color: #445; font-weight: 500;" %>
          <% else %>
            <%= link_to "Мої замовлення", orders_path, style: "text-decoration: none; color: #445; font-weight: 500;" %>
          <% end %>
        <% end %>

        <%= link_to "Кошик (#{session[:cart]&.values&.sum || 0})", cart_path, style: "text-decoration: none; color: #445; font-weight: 500;" %>
        
        <% if authenticated? %>
          <span style="color: #666; font-size: 14px;"><%= Current.user.email_address %></span>
          <%= button_to "Вийти", session_path, method: :delete, form: { style: "display:inline;" }, style: "background: #dc3545; color: white; border: none; padding: 6px 12px; border-radius: 4px; cursor: pointer; font-size: 14px;" %>
        <% else %>
          <%= link_to "Увійти", new_session_path, style: "background: #007bff; color: white; padding: 6px 16px; border-radius: 4px; text-decoration: none; font-weight: 500; font-size: 14px;" %>
        <% end %>
      </div>
    </header>

    <%= yield %>

    <footer>
      <div>
        <strong>CARPET STORE</strong><br>
        вул. Незалежності, 123, Київ, Україна<br>
        Тел: +380 77 123 45 67 | Email: info@carpetstore.ua
      </div>
      <div>
        <%= link_to "Зворотний зв'язок", new_feedback_path, class: "btn-primary", style: "display: inline-block; padding: 10px 16px;" %>
      </div>
    </footer>
  </body>
</html>